    <externalId>false</externalId>
    <formula>IF( NOT( CONTAINS(TEXT(Status), &apos;Closed&apos;) )  , Owner:User.FirstName &amp; &apos; &apos; &amp;   Owner:User.LastName, &apos; &apos;)</formula>
    <label>Owner_Fullname</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
