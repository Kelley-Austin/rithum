<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Case_Closed_On_Time__c</fullName>
    <formula>AND(
 IsClosed , 

DATEVALUE(ClosedDate ) &lt;=  Project_Due_Date__c )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Looks at project due date and closed date to determine if the case was closed on time</inlineHelpText>
    <label>Case Closed On Time</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
