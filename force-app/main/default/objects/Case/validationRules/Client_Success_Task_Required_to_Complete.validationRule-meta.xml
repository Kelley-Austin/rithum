<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Client_Success_Task_Required_to_Complete</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 (RecordType.Name =&quot;Client Success&quot;),
 (ISPICKVAL( Status,&quot;C5 - Completed&quot;)),
ISNULL(Case_Task_Duration_hours__c))</errorConditionFormula>
    <errorMessage>You cannot complete a case with no tasks, Please create a task</errorMessage>
</ValidationRule>
