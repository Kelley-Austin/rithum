<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Enhancement_Request_Submitted_Status</fullName>
    <active>false</active>
    <description>Restricts the use of the &quot;Enhancement Request Submitted&quot; status when closing a case to support management.</description>
    <errorConditionFormula>$RecordType.Name = &quot;Customer Support&quot; 
&amp;&amp; 
