<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Screen Flow launched from the Update Child Cases quick action on a Case. Allows agents to post a Chatter comment to the parent and all child cases, and/or update the status of all child cases in one action.</description>
    <environments>Default</environments>
    <interviewLabel>Brands - Case, Update Child Cases {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Brands - Case, Update Child Cases</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <status>Active</status>

    <!-- ── VARIABLES ─────────────────────────────────────────────────── -->
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varFeedVisibility</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varCurrentChildCase</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <name>varChildFeedItems</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>FeedItem</objectType>
    </variables>
    <variables>
        <name>varNewFeedItem</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>FeedItem</objectType>
    </variables>

    <!-- ── CHOICE SETS ───────────────────────────────────────────────── -->
    <dynamicChoiceSets>
        <name>Case_Status_Options</name>
        <dataType>Picklist</dataType>
        <displayField>Status</displayField>
        <object>Case</object>
        <picklistField>Status</picklistField>
        <picklistObject>Case</picklistObject>
    </dynamicChoiceSets>

    <!-- ── START ─────────────────────────────────────────────────────── -->
    <start>
        <locationX>182</locationX>
        <locationY>26</locationY>
        <connector>
            <targetReference>Screen_Update_Child_Cases</targetReference>
        </connector>
    </start>

    <!-- ── SCREEN ────────────────────────────────────────────────────── -->
    <screens>
        <name>Screen_Update_Child_Cases</name>
        <label>Update Child Cases</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <nextOrFinishButtonLabel>Save</nextOrFinishButtonLabel>
        <fields>
            <name>txtComment</name>
            <dataType>String</dataType>
            <fieldText>Send Comment to Child Cases</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>chkIsPublic</name>
            <dataType>Boolean</dataType>
            <defaultValue>
                <booleanValue>false</booleanValue>
            </defaultValue>
            <fieldText>Comment is Public</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>pickNewStatus</name>
            <choiceReferences>Case_Status_Options</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Update Child Case Statuses</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <connector>
            <targetReference>Decision_Has_Comment</targetReference>
        </connector>
    </screens>

    <!-- ── DECISIONS (all grouped) ───────────────────────────────────── -->
    <decisions>
        <name>Decision_Has_Comment</name>
        <label>Comment Populated?</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Decision_Has_Status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Comment</defaultConnectorLabel>
        <rules>
            <name>Comment_Populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>txtComment</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>txtComment</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Child_Cases</targetReference>
            </connector>
            <label>Comment Populated</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Is_Public</name>
        <label>Comment is Public?</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Assign_Visibility_Internal</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Internal Only</defaultConnectorLabel>
        <rules>
            <name>Is_Public</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>chkIsPublic</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Visibility_Public</targetReference>
            </connector>
            <label>Public</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Has_Status</name>
        <label>Status Update Selected?</label>
        <locationX>182</locationX>
        <locationY>1106</locationY>
        <defaultConnectorLabel>No Status Update</defaultConnectorLabel>
        <rules>
            <name>Status_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>pickNewStatus</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>pickNewStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Child_Case_Statuses</targetReference>
            </connector>
            <label>Status Selected</label>
        </rules>
    </decisions>

    <!-- ── RECORD LOOKUPS ────────────────────────────────────────────── -->
    <recordLookups>
        <name>Get_Child_Cases</name>
        <label>Get Child Cases</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Is_Public</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <!-- ── ASSIGNMENTS (all grouped) ─────────────────────────────────── -->
    <assignments>
        <name>Assign_Visibility_Public</name>
        <label>Set Visibility to Public</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>varFeedVisibility</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>AllUsers</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Parent_Chatter_Post</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Visibility_Internal</name>
        <label>Set Visibility to Internal</label>
        <locationX>314</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>varFeedVisibility</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>InternalUsers</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Parent_Chatter_Post</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Child_Feed_Item</name>
        <label>Build Child Feed Item</label>
        <locationX>50</locationX>
        <locationY>890</locationY>
        <assignmentItems>
            <assignToReference>varNewFeedItem.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varCurrentChildCase.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewFeedItem.Body</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>txtComment</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewFeedItem.Visibility</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varFeedVisibility</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewFeedItem.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>TextPost</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varChildFeedItems</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varNewFeedItem</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Child_Cases</targetReference>
        </connector>
    </assignments>

    <!-- ── LOOPS ─────────────────────────────────────────────────────── -->
    <loops>
        <name>Loop_Child_Cases</name>
        <label>Loop Through Child Cases</label>
        <locationX>182</locationX>
        <locationY>782</locationY>
        <assignNextValueToReference>varCurrentChildCase</assignNextValueToReference>
        <collectionReference>Get_Child_Cases</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Child_Feed_Item</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Child_Chatter_Posts</targetReference>
        </noMoreValuesConnector>
    </loops>

    <!-- ── RECORD CREATES (both grouped) ─────────────────────────────── -->
    <recordCreates>
        <name>Create_Parent_Chatter_Post</name>
        <label>Create Parent Chatter Post</label>
        <locationX>182</locationX>
        <locationY>674</locationY>
        <inputAssignments>
            <field>ParentId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Body</field>
            <value>
                <elementReference>txtComment</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Visibility</field>
            <value>
                <elementReference>varFeedVisibility</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <stringValue>TextPost</stringValue>
            </value>
        </inputAssignments>
        <object>FeedItem</object>
        <connector>
            <targetReference>Loop_Child_Cases</targetReference>
        </connector>
    </recordCreates>
    <recordCreates>
        <name>Create_Child_Chatter_Posts</name>
        <label>Create Child Chatter Posts</label>
        <locationX>182</locationX>
        <locationY>998</locationY>
        <inputReference>varChildFeedItems</inputReference>
        <connector>
            <targetReference>Decision_Has_Status</targetReference>
        </connector>
    </recordCreates>

    <!-- ── RECORD UPDATES ─────────────────────────────────────────────── -->
    <recordUpdates>
        <name>Update_Child_Case_Statuses</name>
        <label>Update Child Case Statuses</label>
        <locationX>182</locationX>
        <locationY>1214</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>pickNewStatus</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>

</Flow>
