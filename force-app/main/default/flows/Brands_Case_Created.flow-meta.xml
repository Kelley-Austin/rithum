<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Triggers on Brands Case creation and launches the Omni-Channel routing flow.</description>
    <label>Brands - Case, Created</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Launch_Omni_Channel_Routing</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>Platform__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Brands</stringValue>
            </value>
        </filters>
        <filters>
            <field>RecordType.DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Ongoing_Support</stringValue>
            </value>
        </filters>
        <filters>
            <field>RecordType.DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Support_Admin</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Launch_Omni_Channel_Routing</name>
        <label>Launch Brands - Omni Channel Routing</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <flowName>Brands_Omni_Channel_Routing</flowName>
        <inputAssignments>
            <name>inputCase</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
