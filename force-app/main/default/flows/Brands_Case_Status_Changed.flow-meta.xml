<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Invocable helper flow called when Case Status changes. Sets Brands Status Datetime when Status becomes Escalated to Engineering; clears it when Status changes away from that value.</description>
    <environments>Default</environments>
    <interviewLabel>Brands - Case, Status Changed {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Brands - Case, Status Changed</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <variables>
        <name>varR_Case</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <name>varT_StatusPriorValue</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varNull_DateTime</name>
        <dataType>DateTime</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <start>
        <locationX>182</locationX>
        <locationY>26</locationY>
        <connector>
            <targetReference>Check_Status_Transition</targetReference>
        </connector>
    </start>
    <decisions>
        <name>Check_Status_Transition</name>
        <label>Check Status Transition</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Update_Case</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Status Change</defaultConnectorLabel>
        <rules>
            <name>Is_Escalated_to_Engineering</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varR_Case.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Escalated to Engineering</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Brands_Status_Datetime</targetReference>
            </connector>
            <label>Is Escalated to Engineering</label>
        </rules>
        <rules>
            <name>Was_Escalated_to_Engineering</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varT_StatusPriorValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Escalated to Engineering</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_Brands_Status_Datetime</targetReference>
            </connector>
            <label>Was Escalated to Engineering</label>
        </rules>
    </decisions>
    <assignments>
        <name>Set_Brands_Status_Datetime</name>
        <label>Set Brands Status Datetime</label>
        <locationX>50</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>varR_Case.Brands_Status_Datetime__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Case</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Clear_Brands_Status_Datetime</name>
        <label>Clear Brands Status Datetime</label>
        <locationX>314</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>varR_Case.Brands_Status_Datetime__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varNull_DateTime</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Case</targetReference>
        </connector>
    </assignments>
    <recordUpdates>
        <name>Update_Case</name>
        <label>Update Case</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <inputReference>varR_Case</inputReference>
    </recordUpdates>
</Flow>
