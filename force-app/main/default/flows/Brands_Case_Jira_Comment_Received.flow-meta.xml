<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Posts a Chatter message to the Case record so that the case owner and followers are notified of the new Jira comment</description>
        <name>Post_Jira_Comment_Notification</name>
        <label>Post Jira Comment Notification to Case Feed</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <actionName>chatterPost</actionName>
        <actionType>chatterPost</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>text</name>
            <value>
                <elementReference>txtJiraUpdate</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>subjectNameOrId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>chatterPost</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <description>Posts a Chatter message to the Case feed when a new Jira comment is received, alerting the case owner and all followers that engineering context is available in the Case Comments section.</description>
    <environments>Default</environments>
    <interviewLabel>Brands - Case, Jira Comment Received {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Brands - Case, Jira Comment Received</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Triggering_Case_s_Status</name>
        <label>Update Triggering Case&apos;s Status</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <connector>
            <targetReference>Post_Jira_Comment_Notification</targetReference>
        </connector>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Action Required</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Triggering_Case_s_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Last_Jira_Comment_Date_Time__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Platform__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Brands</stringValue>
            </value>
        </filters>
        <filters>
            <field>Block_Jira_Updates__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Last_Jira_Comment_Date_Time__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>Chatter_Message</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>A new comment from the linked Jira ticket has been added to this case. Review the Case Comments section for the latest engineering update.</text>
    </textTemplates>
    <textTemplates>
        <name>txtJiraUpdate</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;@[{!$Record.Assignee_Id__c}] Please review the new Jira comment&lt;/p&gt;</text>
    </textTemplates>
</Flow>
