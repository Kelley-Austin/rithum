    </start>
    <status>Active</status>
    <textTemplates>
        <name>tmplChatterBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;This Case has been transferred&lt;/p&gt;&lt;p&gt;Account: &lt;a href=&quot;/{!Get_Case.AccountId}&quot;&gt;{!Get_Account.Name}&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Contact: &lt;a href=&quot;/{!Get_Case.ContactId}&quot;&gt;{!Get_Contact.Name}&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Organization: &lt;a href=&quot;/{!Get_Case.Organization__c}&quot;&gt;{!Get_Organization.Name}&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Organization Contact: &lt;a href=&quot;/{!Get_Case.Organization_Contact__c}&quot;&gt;{!Get_OrgContact.Name}&lt;/a&gt;&lt;/p&gt;</text>
    </textTemplates>
    <variables>
